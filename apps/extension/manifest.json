{
  "manifest_version": 3,
  "name": "NAVI OS",
  "description": "Authorized browser context, session-only Ghost Mode, and approved search recommendations.",
  "version": "0.6.0",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "NAVI OS"
  },
  "externally_connectable": {
    "matches": [
      "http://localhost/*"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "optional_host_permissions": [
    "http://localhost/*"
  ],
  "minimum_chrome_version": "120",
  "optional_permissions": [
    "tabGroups",
    "tabs",
    "identity"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "open-companion": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open NAVI OS browser companion"
    }
  }
}
