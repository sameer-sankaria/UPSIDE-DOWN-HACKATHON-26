{
  "name": "navi-os",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "npm run dev -w @navi-os/web",
    "build": "npm run build --workspaces --if-present",
    "build:extension": "npm run build -w @navi-os/extension",
    "start": "npm run start -w @navi-os/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "tsx --test tests/*.test.ts",
    "test:http": "node scripts/smoke-http.mjs",
    "test:db": "node scripts/test-database.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "jsdom": "^30.1.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
